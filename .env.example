# Supabase (required for cloud sync)
SUPABASE_URL=https://your-project.supabase.co
# Use anon key or new publishable key from Supabase Dashboard → API
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Use anon/publishable key OR legacy service_role JWT OR new secret key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-sb-secret-key
# Optional — only needed for legacy HS256 projects; ES256 uses JWKS automatically
SUPABASE_JWT_SECRET=
# Optional — apply migration: scripts/apply_supabase_migration.py
# SUPABASE_DB_PASSWORD=your-database-password

# Frontend + Companion (Vite — NOT Next.js NEXT_PUBLIC_*)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Companion production API (local dev uses Vite proxy)
# VITE_API_BASE_URL=https://your-api.example.com
