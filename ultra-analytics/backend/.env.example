# Ultra — paste ONLY the four secrets below. URLs derive from PUBLIC_URL.

PUBLIC_URL=https://rydn.bike

# Optional later (Railway / VPS split) — leave blank to inherit PUBLIC_URL:
# APP_URL=
# API_URL=
# MARKETING_URL=

TUNNEL_NAME=ultra-local
TUNNEL_HOSTNAME=rydn.bike
PORT_FE=5180
PORT_BE=8100

# =============================================================================
# GOOGLE  →  https://console.cloud.google.com/apis/credentials
# JS origin:     ${PUBLIC_URL}
# Redirect URI:  ${PUBLIC_URL}/api/auth/google/callback
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Maps Platform — server-side only, never Vite / never commit.
# Enable in GCP: Maps JavaScript API + Street View Metadata API
# (Street View Static optional). Restrict key by HTTP referrer for JS
# (https://rydn.bike/*) and serve via GET /api/maps/js-config.
GOOGLE_MAPS_API_KEY=

# =============================================================================
# STRAVA  →  https://www.strava.com/settings/api
# Callback domain: hostname of PUBLIC_URL (rydn.bike)
# =============================================================================
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Stripe Billing — see ../BILLING.md (3 values)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
