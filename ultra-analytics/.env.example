# RYDN — environment variables
#
# Local:  copy to ultra-analytics/.env and fill values (./dev.sh loads this).
# Railway: paste the same keys into Service → Variables (never commit secrets).
#
# Process environment always wins over this file.

# ---------------------------------------------------------------------------
# Required in production (Railway)
# ---------------------------------------------------------------------------

# Long random signing key for session cookies + token encryption.
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ULTRA_SECRET=

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps Platform — server-side only (Metadata proxy + lazy Maps JS key).
# Never put this in VITE_* / frontend bundles. Enable in GCP:
#   - Maps JavaScript API  (embedded Street View panorama)
#   - Street View Metadata API
# Restrict key by HTTP referrer (https://rydn.bike/*) for JS; signed-in clients
# fetch the key from GET /api/maps/js-config. Alias: GOOGLE_API_KEY=
GOOGLE_MAPS_API_KEY=

# Strava API (https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# URLs — production defaults are applied automatically on Railway
# ---------------------------------------------------------------------------

# Public site (SPA). Defaults to https://rydn.bike in production.
PUBLIC_URL=https://rydn.bike

# Browser / OAuth origin (defaults to PUBLIC_URL)
APP_URL=https://rydn.bike

# API origin (defaults to PUBLIC_URL). Same-origin is recommended.
# Split host example: API_URL=https://api.rydn.bike
API_URL=https://rydn.bike

# Marketing site (defaults to PUBLIC_URL)
MARKETING_URL=https://rydn.bike

# Explicit OAuth redirects (optional — derived from API_URL when empty)
# GOOGLE_REDIRECT_URI=https://rydn.bike/api/auth/google/callback
# STRAVA_REDIRECT_URI=https://rydn.bike/api/providers/strava/callback

# ---------------------------------------------------------------------------
# Runtime (set automatically in the Docker image / on Railway)
# ---------------------------------------------------------------------------

# development | production — auto = production when RAILWAY_* is present
# ULTRA_ENV=production

# Persistent data directory — Docker/Railway default is /data
# ULTRA_DATA_DIR=/data

# Extra CORS origins (comma-separated). rydn.bike + api.rydn.bike always included in prod.
# CORS_ORIGINS=

# Cookie flags — auto Secure on HTTPS/Railway; cross-subdomain auto when APP≠API host
# ULTRA_COOKIE_SECURE=1
# ULTRA_COOKIE_DOMAIN=.rydn.bike
# ULTRA_COOKIE_SAMESITE=none

# Logging
# ULTRA_LOG_LEVEL=INFO
# ULTRA_LOG_JSON=1

# Debug OAuth authorize URLs (never enable in production unless debugging)
# ULTRA_OAUTH_DEBUG=0

# ---------------------------------------------------------------------------
# Local development only (./dev.sh) — ignore on Railway
# ---------------------------------------------------------------------------

# Empty VITE_API_BASE = same-origin /api via Vite proxy
# VITE_API_BASE=
# VITE_PUBLIC_URL=http://localhost:5180
